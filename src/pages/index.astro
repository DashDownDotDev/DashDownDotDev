---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import TestCounter from "../components/TestCounter.tsx";
import { getCollection } from "astro:content";

const posts = await getCollection("musings");
---

// Welcome to Astro! Wondering what to do next? Check out the Astro
documentation at https://docs.astro.build // Don't want to use any of this?
Delete everything in this file, the `assets`, `components`, and `layouts`
directories, and start fresh. ---

<Layout>
	<Welcome />

	<!-- hydrate on load -->
	<TestCounter client:load />

	<div>
		<h2>Posts from MDX:</h2>
		{
			posts.map((post) => (
				<div>
					<h3>{post.data.title}</h3>
					<p>{post.data.description}</p>
				</div>
			))
		}
	</div>
	<div
		class="flex min-h-screen items-center justify-center bg-zinc-950 text-zinc-100"
	>
		<div
			class="rounded-xl border border-zinc-800 bg-zinc-900 px-6 py-4 shadow-lg"
		>
			<h1 class="text-lg font-semibold tracking-tight">Tailwind is working</h1>
			<p class="mt-2 text-sm text-zinc-400">This is native Astro.</p>
		</div>
	</div>
</Layout>
