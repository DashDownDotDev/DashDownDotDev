---
import "../styles/global.css";
import Backdrop from "~/components/Backdrop";
import NavLink from "../components/NavLink.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>DashDown.dev</title>
	</head>
	<body>
		<Backdrop client:load />
		<header
			class="sticky top-0 z-20 border-b border-white/10 bg-black/20 backdrop-blur"
		>
			<div class="mx-auto max-w-[72ch] px-4 sm:px-6 lg:px-8">
				<nav aria-label="Primary" class="py-4">
					<ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
						<NavLink href="/" exact>home</NavLink>
						<NavLink href="/exhibits">exhibits</NavLink>
						<NavLink href="/musings">musings</NavLink>
						<NavLink href="/motivations">motivations</NavLink>
					</ul>
				</nav>
			</div>
		</header>

		<main class="mx-auto max-w-[72ch] px-4 py-10 sm:px-6 lg:px-8">
			<slot />
		</main>

		<footer class="mt-16 border-t border-white/10">
			<div class="mx-auto max-w-[72ch] px-4 sm:px-6 lg:px-8">
				<nav aria-label="Footer" class="py-8 text-sm">
					<ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
						<li>
							<a
								class="navlink"
								href="https://github.com/DashDownDotDev"
								target="_blank"
								rel="noreferrer"
							>
								github.com/DashDownDotDev
							</a>
						</li>
					</ul>
				</nav>
			</div>
		</footer>
	</body>
</html>
