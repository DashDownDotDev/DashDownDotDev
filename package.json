{
	"name": "dashdowndotdev",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"check": "astro check",
		"build": "astro build",
		"test": "vitest --run",
		"preview": "astro preview",
		"sync": "astro sync",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "pnpm run format:core --check",
		"format:core": "prettier \"**/*.{js,jsx,ts,tsx,mjs,css,md,mdx,astro,json,yaml,yml}\"",
		"format:fix": "pnpm run format:core --write",
		"deploy": "wrangler pages deploy"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.8",
		"@astrojs/mdx": "^4.3.13",
		"@astrojs/react": "^4.4.2",
		"@eslint/js": "^9.39.2",
		"@tailwindcss/postcss": "^4.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@typescript-eslint/parser": "^8.59.0",
		"astro": "^5.17.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.7.3",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.0",
		"vitest": "^4.1.5",
		"wrangler": "^4.85.0"
	},
	"engines": {
		"node": ">=25",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@10.28.1"
}
